layout {
  default_tab_template {
    children
    pane size=1 borderless=true {
      plugin location="zellij:compact-bar"
    }
  }

  tab name="[LUMIN] PLATFORM ✨" {
    pane split_direction="vertical" {
      pane split_direction="horizontal" size="40%" {
        pane split_direction="vertical" size="50%" {
          pane name="Aux 1" size="33%" cwd="~/Documents/workspaces/lumin/lumin-platform"
          pane name="Aux 2" size="34%" cwd="~/Documents/workspaces/lumin/lumin-platform"
          pane name="Aux 3" size="33%" cwd="~/Documents/workspaces/lumin/lumin-platform"
        }

        pane split_direction="vertical" size="50%" {
          pane name="Aux 4" size="33%" cwd="~/Documents/workspaces/lumin/lumin-platform"
          pane name="Aux 5" size="34%" cwd="~/Documents/workspaces/lumin/lumin-platform"
          pane name="Aux 6" size="33%" cwd="~/Documents/workspaces/lumin/lumin-platform"
        }
      }
    }
  }
}